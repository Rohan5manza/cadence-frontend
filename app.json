{
  "expo": {
    "name": "cadence-app",
    "slug": "cadence-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cadence-icon.png",
    "scheme": "cadenceapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cadence-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
  "expo-splash-screen",
  {
    "backgroundColor": "#0A0A0F",
    "image": "./assets/images/cadence-icon.png",
    "imageWidth": 200,
    "resizeMode": "contain",
    "ios": {
      "image": "./assets/images/cadence-icon.png",
      "imageWidth": 200,
      "backgroundColor": "#0A0A0F",
      "resizeMode": "contain"
    },
    "android": {
      "image": "./assets/images/cadence-icon.png",
      "imageWidth": 200,
      "backgroundColor": "#0A0A0F",
      "resizeMode": "contain"
    }
  }
],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
