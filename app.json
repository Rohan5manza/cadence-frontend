{
  "expo": {
    "name": "cadence-app",
    "slug": "cadence-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cadence-icon.png",
    "scheme": "cadenceapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cadence-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rohan5marar.cadenceapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/images/cadence-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/images/cadence-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#0A0A0F",
            "resizeMode": "contain"
          },
          "android": {
            "package": "com.rohan5marar.cadenceapp",
            "versionCode": 1,
            "permissions": [
              "android.permission.READ_EXTERNAL_STORAGE",
              "android.permission.WRITE_EXTERNAL_STORAGE",
              "android.permission.INTERNET"
            ],
            "adaptiveIcon": {
              "backgroundColor": "#0A0A0F",
              "foregroundImage": "./assets/images/cadence-icon.png",
              "backgroundImage": "./assets/images/android-icon-background.png",
              "monochromeImage": "./assets/images/android-icon-monochrome.png"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00975b56-79eb-43b2-9520-9c4adac2c052"
      }
    }
  }
}